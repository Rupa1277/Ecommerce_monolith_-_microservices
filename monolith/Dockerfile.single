# Build from repo ROOT:  docker build -f monolith/Dockerfile.single -t shop-app:1.0 .
FROM node:20-alpine AS frontend-build
WORKDIR /fe
COPY frontend/package.json .
RUN npm install
COPY frontend .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY monolith/backend/package.json .
RUN npm install
COPY monolith/backend .
COPY --from=frontend-build /fe/dist ./public
EXPOSE 3000
CMD ["node", "server.js"]
